{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcagentlauncher.dev/schemas/resource-plan.schema.json",
  "title": "MCagentlauncher Resource Plan",
  "description": "Auditable resource configuration plan generated before user confirmation. This is not installed state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "intentId",
    "status",
    "target",
    "summary",
    "resources",
    "ruleResults",
    "installActionRef",
    "userConfirmation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "planId": {
      "type": "string",
      "pattern": "^plan_[a-z0-9][a-z0-9_-]{5,63}$"
    },
    "intentId": {
      "type": "string",
      "pattern": "^intent_[a-z0-9][a-z0-9_-]{5,63}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs-user-confirmation",
        "rejected"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minecraftVersion",
        "loader",
        "loaderVersion",
        "javaMajorVersion"
      ],
      "properties": {
        "minecraftVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+(\\.[0-9]+)?$"
        },
        "loader": {
          "type": "string",
          "const": "fabric"
        },
        "loaderVersion": {
          "type": "string",
          "minLength": 1
        },
        "javaMajorVersion": {
          "type": "integer",
          "enum": [
            17,
            21
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "riskLevel",
        "estimatedMemoryMb"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "riskLevel": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "estimatedMemoryMb": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65536
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resourceCandidate"
      }
    },
    "ruleResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "rejected",
        "warnings",
        "errors"
      ],
      "properties": {
        "accepted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleMessage"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleMessage"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleMessage"
          }
        }
      }
    },
    "installActionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "schema"
      ],
      "properties": {
        "actionId": {
          "type": "string",
          "pattern": "^install_[a-z0-9][a-z0-9_-]{5,63}$"
        },
        "schema": {
          "type": "string",
          "const": "install-action.schema.json"
        }
      }
    },
    "userConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "confirmed"
      ],
      "properties": {
        "required": {
          "type": "boolean",
          "const": true
        },
        "confirmed": {
          "type": "boolean",
          "const": false
        }
      }
    }
  },
  "$defs": {
    "resourceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "type",
        "source",
        "project",
        "version",
        "required",
        "reason",
        "compatibility",
        "verification"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^res_[a-z0-9][a-z0-9_-]{5,63}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "mod",
            "resourcepack",
            "shaderpack"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "modrinth",
            "manual",
            "community-rule"
          ]
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "slug",
            "projectId"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-_]{1,80}$"
            },
            "projectId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "version": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "versionId",
            "versionNumber",
            "releaseType"
          ],
          "properties": {
            "versionId": {
              "type": "string",
              "minLength": 1
            },
            "versionNumber": {
              "type": "string",
              "minLength": 1
            },
            "releaseType": {
              "type": "string",
              "enum": [
                "release",
                "beta",
                "alpha"
              ]
            }
          }
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minecraftVersions",
            "loaders",
            "side"
          ],
          "properties": {
            "minecraftVersions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^1\\.[0-9]+(\\.[0-9]+)?$"
              }
            },
            "loaders": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "const": "fabric"
              }
            },
            "side": {
              "type": "string",
              "enum": [
                "client",
                "server",
                "both"
              ]
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metadataChecked",
            "hashKnown",
            "licenseChecked"
          ],
          "properties": {
            "metadataChecked": {
              "type": "boolean"
            },
            "hashKnown": {
              "type": "boolean"
            },
            "licenseChecked": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "ruleMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{3,80}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
