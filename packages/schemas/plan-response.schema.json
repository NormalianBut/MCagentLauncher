{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcagentlauncher.dev/schemas/plan-response.schema.json",
  "title": "MCagentlauncher Plan Response",
  "description": "Wrapper response for resource planning APIs. The embedded plan is validated separately against resource-plan.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plan",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "plan": {
      "type": "object",
      "description": "Must also validate against resource-plan.schema.json."
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aliasMatches",
        "resolverQueries",
        "candidatesResolved",
        "warnings",
        "errors",
        "networkUsed"
      ],
      "properties": {
        "aliasMatches": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "resolverQueries": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "candidatesResolved": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnosticMessage"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnosticMessage"
          }
        },
        "networkUsed": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "diagnosticMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{3,80}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
