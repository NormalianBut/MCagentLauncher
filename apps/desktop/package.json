{
  "name": "@mcagentlauncher/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:version": "node scripts/check-version.mjs",
    "check:security": "node scripts/check-tauri-security.mjs",
    "tauri:dev": "tauri dev",
    "package": "pnpm check:version && pnpm check:security && tauri build --bundles nsis && node scripts/prepare-preview-artifacts.mjs",
    "package:windows": "pnpm package"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
