{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCagentlauncher",
  "version": "0.1.0",
  "identifier": "dev.mcagentlauncher.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MCagentlauncher Desktop Shell",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ]
  }
}
