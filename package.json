{
  "name": "mcagentlauncher",
  "version": "0.1.0",
  "packageManager": "pnpm@11.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "cd services/mcagent-server && python -m uvicorn app.main:app --reload",
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "dev:desktop": "pnpm --dir apps/desktop dev",
    "build:desktop": "pnpm --dir apps/desktop build",
    "check:desktop-version": "pnpm --dir apps/desktop check:version",
    "check:desktop-security": "pnpm --dir apps/desktop check:security",
    "package:desktop": "pnpm --dir apps/desktop package",
    "package:desktop:windows": "pnpm --dir apps/desktop package:windows",
    "check:autonomy-boundaries": "node scripts/check-autonomy-boundaries.mjs",
    "autonomy:status": "node scripts/autonomy-status.mjs",
    "autonomy:pause": "node scripts/autonomy-pause.mjs",
    "autonomy:resume": "node scripts/autonomy-resume.mjs",
    "autonomy:doctor": "node scripts/autonomy-doctor.mjs",
    "autonomy:cleanup": "node scripts/autonomy-cleanup.mjs",
    "test:autonomy-runtime": "node --test tests/autonomy-runtime.test.mjs",
    "verify:project": "node scripts/verify-project.mjs",
    "test:api-client": "pnpm --dir packages/api-client test",
    "test:shared-types": "pnpm --dir packages/shared-types test",
    "validate:schemas": "node packages/schemas/scripts/validate.mjs"
  }
}
